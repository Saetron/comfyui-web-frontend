# ComfyUI Host URL
# - On Docker Desktop (Windows / macOS): http://host.docker.internal:8188
# - On Linux with host-gateway: http://host.docker.internal:8188
# - If ComfyUI is on a remote LAN machine: http://192.168.1.100:8188
COMFYUI_URL=http://host.docker.internal:8188

# Application Port
PORT=8080
